<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-controller="Learner" asp-action="Index">Management System</a>
        <form class="d-flex">
            <input class="form-control form-control-sm me-1" type="search" placeholder="Search for..." />
            <button class="btn btn-primary btn-sm" type="button">Search</button>
        </form>
    </nav>
    <div class="d-flex">
        <aside class="sidebar bg-dark text-white-50 p-3">
            <div class="small text-uppercase mb-2">Core</div>
            <a class="d-block text-white-50 mb-3" asp-controller="Learner" asp-action="Index">Dashboard</a>
            <div class="small text-uppercase mb-2">Addons</div>
            <a class="d-block text-white-50 mb-2" asp-controller="Learner" asp-action="Index">Learners</a>
            <a class="d-block text-white-50 mb-2" asp-controller="Learner" asp-action="Create">Create Learner</a>
            <div class="sidebar-footer small">Logged in as: MyAccount</div>
        </aside>
        <main class="flex-grow-1 p-3">
            @RenderBody()
            <footer class="text-muted small mt-5">Copyright &copy; @DateTime.Now.Year</footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
